# Vite 빌드 시점에 주입되는 API 기본 URL입니다.
# 같은 도메인에서 리버스 프록시로 붙는 배포 예시:
VITE_API_BASE_URL=/api/v1

# 백엔드 절대 주소를 직접 쓰는 배포 예시:
# VITE_API_BASE_URL=https://api.example.com/api/v1

# 배포 환경에서는 mock 모드를 false 로 유지합니다.
VITE_USE_MOCK=false

# mock/demo 흐름에서 기본으로 쓰는 발신 번호입니다.
VITE_CALLER_PHONE=01049163720

# 개발 서버 프록시 전용 값입니다. 프로덕션 빌드 결과물에서는 사용되지 않습니다.
VITE_API_PROXY_TARGET=http://localhost:8080

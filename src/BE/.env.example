# 공통
SPRING_PROFILES_ACTIVE=local
JWT_SECRET=replace-with-at-least-32-characters

# core-app DB
DB_HOST=postgres
DB_USER=waddoc
DB_PASSWORD=waddoc_dev

# notification-service DB
NOTIFICATION_DB_HOST=notification-postgres
NOTIFICATION_DB_USER=waddoc
NOTIFICATION_DB_PASSWORD=waddoc_notification_dev

# Redis / Kafka / MQTT
# host JVM 실행 시 Redis 포트는 core-app=6379, notification-service=6380, robot-gateway=6381을 사용한다.
REDIS_HOST=redis
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
MQTT_BROKER_URL=ws://mosquitto:9001
MQTT_CLIENT_ID=robot-gateway-local

# LiveKit / AI
LIVEKIT_HOST=http://host.docker.internal:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_URL=ws://host.docker.internal:7880
AI_IDV_URL=http://host.docker.internal:8010/idv/api/v1/verify
AI_IDV_TIMEOUT_MS=20000

# 파일 저장소
FILE_STORAGE_ROOT=/data/uploads

# SMS (notification-service)
SOLAPI_API_KEY=your-solapi-api-key
SOLAPI_API_SECRET=your-solapi-api-secret
SOLAPI_SENDER_NUMBER=029302266
SMS_CONTACT_NUMBER=01049163720

# seed / robot / telemetry
APP_SEED_ENABLED=true
APP_SEED_DEFAULT_PASSWORD=Passw0rd!
ROBOT_TERMINAL_REGISTRY=robot-terminal-01|change-me|veh_GIMCHEON_01|GIMCHEON;robot-terminal-02|change-me-2|veh_ANDONG_01|ANDONG
TELEMETRY_API_KEY=telemetry-dev-key

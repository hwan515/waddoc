# Spring 프로필
SPRING_PROFILES_ACTIVE=prod

# 데이터베이스
DB_HOST=postgres
DB_USER=waddoc
DB_PASSWORD=change-me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# JWT
JWT_SECRET=replace-with-at-least-32-characters

# AI 서비스
AI_IDV_URL=https://gpu.example.com/idv/api/v1/verify
AI_TRIAGE_URL=https://gpu.example.com/triage/api/v1/recommend
AI_IDV_TRANSFER_MODE=multipart
AI_IDV_TIMEOUT_MS=5000

# 파일 저장소
FILE_STORAGE_ROOT=/data/uploads

# SMS (SOLAPI)
SOLAPI_API_KEY=your-solapi-api-key
SOLAPI_API_SECRET=your-solapi-api-secret
SOLAPI_SENDER_NUMBER=029302266
SMS_CONTACT_NUMBER=01049163720

# LiveKit
LIVEKIT_HOST=http://livekit:7880
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_URL=wss://api.example.com/livekit

# prod 설정에서 LIVEKIT_URL을 비웠을 때 사용할 예비 도메인
SERVER_DOMAIN=api.example.com

# 참고
# - application-prod.yml 에서는 sms.provider=solapi 를 직접 사용하므로 SMS_PROVIDER 환경변수는 필요 없습니다.
# - infra/docker-compose.prod.yml 로 배포하면 해당 compose 용 env 에
#   POSTGRES_DB, POSTGRES_USER, SERVER_DOMAIN, PROD_GPU_SERVER_HOST 도 함께 넣어야 합니다.

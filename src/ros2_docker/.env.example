# Local single-PC development defaults
UNITY_CAM_RTSP_URL=rtsp://127.0.0.1:8554/unity_cam
MEDIAMTX_WEBRTC_PUBLIC_HOST=127.0.0.1

# If you want to view the stream from another device on the same LAN,
# replace MEDIAMTX_WEBRTC_PUBLIC_HOST with this machine's LAN IP.
# Example:
# MEDIAMTX_WEBRTC_PUBLIC_HOST=192.168.0.10

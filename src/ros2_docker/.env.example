# Default path: publish camera to the EC2 MediaMTX relay
UNITY_CAM_EC2_HOST=www.waddoc.site
UNITY_CAM_RTSP_URL=rtsp://www.waddoc.site:8554/unity_cam

# Local MediaMTX fallback only. Override when you explicitly want single-PC or LAN-local viewing.
MEDIAMTX_WEBRTC_PUBLIC_HOST=127.0.0.1
# Example:
# UNITY_CAM_RTSP_URL=rtsp://127.0.0.1:8554/unity_cam
# MEDIAMTX_WEBRTC_PUBLIC_HOST=192.168.0.10

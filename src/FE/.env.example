# 로컬 npm run dev 실행 시 사용하는 차량 단말 ID.
# 백엔드 ROBOT_TERMINAL_REGISTRY 의 한 엔트리와 정확히 일치해야 한다.
VITE_ROBOT_TERMINAL_ID=robot-terminal-01
# 로컬 npm run dev 실행 시 사용하는 차량 단말 공유 키.
# 백엔드 ROBOT_TERMINAL_REGISTRY 의 같은 엔트리 key 값과 정확히 일치해야 한다.
VITE_ROBOT_TERMINAL_KEY=change-me
# 운영자 관제 화면이 실시간으로 추적할 차량 ID.
VITE_ACTIVE_OPERATOR_VEHICLE_ID=veh_GIMCHEON_01
# true면 로봇 홈에서 도착 MQTT 없이도 바로 WebRTC fast path를 연다.
VITE_ROBOT_DIRECT_WEBRTC_ENABLED=false
VITE_DEMO_MODE_ENABLED=false

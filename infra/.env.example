# Database
DB_PASSWORD=changeme
POSTGRES_DB=waddoc
POSTGRES_USER=waddoc
# Redis
REDIS_PASSWORD=changeme
# LiveKit
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
# GPU Server
DEV_GPU_SERVER_HOST=10.0.0.10
PROD_GPU_SERVER_HOST=10.0.0.20
# Domain (prod)
SERVER_DOMAIN=example.com
# SSL cert mount path
CERTS_DIR=/home/ubuntu/.waddoc/certs
# JWT
JWT_SECRET=changeme
MISSION_TERMINAL_TOKEN_EXPIRY=1800
# SMS (Solapi)
SOLAPI_API_KEY=changeme
SOLAPI_API_SECRET=changeme
SOLAPI_SENDER_NUMBER=01012345678
# Mission telemetry
TELEMETRY_API_KEY=telemetry-prod-key
# Temporary bypass for identity verification when AI IDV server is unavailable
CONSULTATION_IDENTITY_CHECK_BYPASS_ENABLED=false

# Seed bootstrap (local default: true, prod default: false)
# 더미 데이터 넣는 용도
APP_SEED_ENABLED=false
APP_SEED_DEFAULT_PASSWORD=Passw0rd!

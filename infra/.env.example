# 운영 서버에서는 이 파일을 복사해 /home/ubuntu/.waddoc/prod.env 로 사용한다.
# 아래 값 중 changeme 계열과 example.com 계열은 반드시 실제 운영값으로 교체한다.

# 필수: 데이터베이스
DB_PASSWORD=changeme
POSTGRES_DB=waddoc
POSTGRES_USER=waddoc
NOTIFICATION_DB_USER=waddoc
NOTIFICATION_DB_PASSWORD=changeme-notification

# 필수: 서비스별 Redis 비밀번호
CORE_REDIS_PASSWORD=changeme-core-redis
NOTIFICATION_REDIS_PASSWORD=changeme-notification-redis
ROBOT_REDIS_PASSWORD=changeme-robot-redis

# 필수: JWT / 내부 인증
JWT_SECRET=changeme
MONITORING_COOKIE_SECRET=changeme-monitoring-cookie-secret

# 필수: LiveKit / TURN
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_NODE_IP=203.0.113.10
LIVEKIT_WEBHOOK_URL=http://core-app:8080/api/v1/sessions/webhook/livekit
# coturn과 LiveKit이 공유하는 정적 TURN 인증 값이다.
TURN_SECRET=changeme-to-random-secret

# 필수: 운영 도메인 / 인증서
SERVER_DOMAIN=example.com
CERTS_DIR=/home/ubuntu/.waddoc/certs

# 필수: 외부 연동
SOLAPI_API_KEY=changeme
SOLAPI_API_SECRET=changeme
SOLAPI_SENDER_NUMBER=01012345678
SMS_CONTACT_NUMBER=01012345678
TELEMETRY_API_KEY=telemetry-prod-key

# 필수: 로봇 단말
# 백엔드는 ROBOT_TERMINAL_REGISTRY만 신뢰한다.
# 형식: terminalId|terminalKey|vehicleId|regionCode;terminalId|terminalKey|vehicleId|regionCode
# vehicleId는 DB의 vehicle.public_id와 같아야 한다.
ROBOT_TERMINAL_REGISTRY=robot-terminal-01|change-me|veh_GIMCHEON_01|GIMCHEON;robot-terminal-02|change-me-2|veh_ANDONG_01|ANDONG
# 프론트 컨테이너 시작 시 runtime-config.js에 주입되는 현재 차량 단말 값이다.
# 아래 값은 ROBOT_TERMINAL_REGISTRY의 엔트리 중 하나와 정확히 일치해야 한다.
VITE_ROBOT_TERMINAL_ID=robot-terminal-01
VITE_ROBOT_TERMINAL_KEY=change-me

# 필수: Grafana 관리자 계정
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme

# 선택: GPU 서버
# 기본값은 host 기반 조합이다. 커스텀 포트나 http 스킴을 쓰면 AI_IDV_URL을 직접 지정한다.
DEV_GPU_SERVER_HOST=10.0.0.10
PROD_GPU_SERVER_HOST=10.0.0.20
# 직접 지정이 필요한 경우 사용. 예: http://70.12.130.107:8010/idv/api/v1/verify
AI_IDV_URL=
# AI-IDV 호출 타임아웃(ms). GPU 서버 지연 시 백엔드가 실패로 판단하는 기준이다.
AI_IDV_TIMEOUT_MS=5000

# 선택: Unity camera relay
UNITY_CAM_PROXY_TARGET=http://mediamtx:8889/unity_cam
MEDIAMTX_WEBRTC_PUBLIC_HOST=127.0.0.1
UNITY_CAM_RTSP_URL=rtsp://127.0.0.1:8554/unity_cam
# 운영 override 예시:
# MEDIAMTX_WEBRTC_PUBLIC_HOST=www.waddoc.site
# UNITY_CAM_RTSP_URL=rtsp://www.waddoc.site:8554/unity_cam

# 선택: 앱 동작 토글
APP_DEMO_MODE_ENABLED=false
CONSULTATION_IDENTITY_CHECK_BYPASS_ENABLED=false
MISSION_TERMINAL_TOKEN_EXPIRY=1800
VITE_ENABLE_MONITORING_TAB=false

# 선택: 시드 부트스트랩
# 운영 기본값은 false다. 더미 데이터가 필요할 때만 true로 올린다.
APP_SEED_ENABLED=false
# APP_SEED_ENABLED=true일 때 필수
APP_SEED_DEFAULT_PASSWORD=change-me

# 선택: 서비스 이미지
# Jenkins를 쓰면 변경된 서비스에는 BUILD_NUMBER 태그가 주입된다.
# 운영 앱 이미지는 latest 대신 불변 태그를 유지한다.
DOCKER_IMAGE_CORE_APP=hwan515/waddoc-backend
CORE_APP_IMAGE_TAG=set-me
DOCKER_IMAGE_EDGE_BFF=hwan515/waddoc-edge-bff
EDGE_BFF_IMAGE_TAG=set-me
DOCKER_IMAGE_NOTIFICATION=hwan515/waddoc-notification
NOTIFICATION_IMAGE_TAG=set-me
DOCKER_IMAGE_ROBOT_GATEWAY=hwan515/waddoc-robot-gateway
ROBOT_GATEWAY_IMAGE_TAG=set-me
DOCKER_IMAGE_FE=hwan515/waddoc-frontend
FE_IMAGE_TAG=set-me
DOCKER_IMAGE_FP=hwan515/waddoc-phone
FP_IMAGE_TAG=set-me

# 선택: Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_EXTERNAL_HOST=localhost
KAFKA_PORT=8092
ZOOKEEPER_CLIENT_PORT=2181
KAFKA_BROKER_ID=1
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false

# Database
DB_PASSWORD=changeme
POSTGRES_DB=waddoc
POSTGRES_USER=waddoc
# Redis
REDIS_PASSWORD=changeme
# LiveKit
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_NODE_IP=203.0.113.10
# TURN (coturn) — LiveKit과 coturn이 공유하는 HMAC 시크릿
TURN_SECRET=changeme-to-random-secret
# GPU Server
# 기본값은 host 기반 조합이다. 커스텀 포트나 http 스킴을 쓰면 아래 AI_IDV_URL을 직접 지정한다.
DEV_GPU_SERVER_HOST=10.0.0.10
PROD_GPU_SERVER_HOST=10.0.0.20
# 직접 지정이 필요한 경우 사용. 예: http://70.12.130.107:8010/idv/api/v1/verify
AI_IDV_URL=
# Domain (prod)
SERVER_DOMAIN=example.com
# SSL cert mount path
CERTS_DIR=/home/ubuntu/.waddoc/certs
# JWT
JWT_SECRET=changeme
# 미션 단말 토큰 만료 시간(초). 본인인증과 환자 토큰 발급 범위만 가진다.
MISSION_TERMINAL_TOKEN_EXPIRY=1800
# Robot terminal
# 백엔드는 ROBOT_TERMINAL_REGISTRY만 신뢰한다.
# 형식: terminalId|terminalKey|vehicleId|regionCode;terminalId|terminalKey|vehicleId|regionCode
# vehicleId는 DB의 vehicle.public_id와 같아야 한다.
ROBOT_TERMINAL_REGISTRY=robot-terminal-01|change-me|veh_GIMCHEON_01|GIMCHEON;robot-terminal-02|change-me-2|veh_ANDONG_01|ANDONG
# 프론트 컨테이너 시작 시 runtime-config.js에 주입되는 현재 차량 단말 값.
# 아래 값은 ROBOT_TERMINAL_REGISTRY의 엔트리 중 하나와 정확히 일치해야 한다.
VITE_ROBOT_TERMINAL_ID=robot-terminal-01
VITE_ROBOT_TERMINAL_KEY=change-me
# AI
# AI-IDV 호출 타임아웃(ms). GPU 서버 지연 시 백엔드가 실패로 판단하는 기준이다.
AI_IDV_TIMEOUT_MS=5000
# SMS (Solapi)
SOLAPI_API_KEY=changeme
SOLAPI_API_SECRET=changeme
SOLAPI_SENDER_NUMBER=01012345678
# Mission telemetry
TELEMETRY_API_KEY=telemetry-prod-key
# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_EXTERNAL_HOST=localhost
KAFKA_PORT=8092
ZOOKEEPER_CLIENT_PORT=2181
KAFKA_BROKER_ID=1
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false
# Temporary bypass for identity verification when AI IDV server is unavailable
CONSULTATION_IDENTITY_CHECK_BYPASS_ENABLED=false

# Seed bootstrap (local default: true, prod default: false)
# 더미 데이터 넣는 용도
APP_SEED_ENABLED=false
APP_SEED_DEFAULT_PASSWORD=Passw0rd!

/**
 * Waddoc CI/CD Pipeline
 *
 * 배포 흐름:
 *   1. GitLab (dev 브랜치 - 추후 master로 수정) push
 *   2. Jenkins agent(EC2)에서 코드 checkout
 *   3. 변경 감지: src/BE, src/FE, src/FE-phone, infra 중 변경된 부분만 처리
 *   4. 변경된 서비스만 Docker buildx → DockerHub push
 *   5. docker compose pull → up -d (변경 서비스만 재시작)
 *
 * 필요한 Jenkins Credentials:
 *   - gitlab-deploy-token  : GitLab Deploy Token (Username+Password)
 *   - dockerhub-credentials : DockerHub 계정
 */
pipeline {
    agent { label 'deploy' }  // EC2(j14a603.p.ssafy.io)에 설치된 Jenkins agent

    options {
        skipDefaultCheckout(true)
        timestamps()
        disableConcurrentBuilds()              // 동시 빌드 방지
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '30', daysToKeepStr: '14'))
    }

    environment {
        BRANCH = 'dev'
        // DockerHub 이미지 이름
        DOCKER_IMAGE_BE = 'hwan515/waddoc-backend'
        DOCKER_IMAGE_FE = 'hwan515/waddoc-frontend'
        DOCKER_IMAGE_FP = 'hwan515/waddoc-phone'
        PROJECT_PATH = '/home/ubuntu/S14P21A603'   // EC2 내 프로젝트 경로
        PROD_ENV_FILE = '/home/ubuntu/.waddoc/prod.env'
        DOCKER_BUILDKIT = '1'
        BUILDX_BUILDER = 'waddoc-builder'          // buildx 빌더 이름 접두사
    }

    stages {
        // GitLab Deploy Token으로 소스 코드 checkout
        stage('Checkout') {
            steps {
                dir("${PROJECT_PATH}") {
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: "*/${BRANCH}"]],
                        userRemoteConfigs: [[
                            url: 'https://lab.ssafy.com/s14-mobility-smarthome-sub1/S14P21A603.git',
                            credentialsId: 'gitlab-deploy-token'
                        ]],
                        extensions: [
                            [$class: 'CleanBeforeCheckout'],
                            [$class: 'CloneOption', shallow: true, depth: 50]
                        ]
                    ])
                }
            }
        }

        // 변경된 파일 경로 기반으로 어떤 서비스를 빌드/배포할지 결정
        stage('Compute Changes') {
            steps {
                script {
                    // Jenkins changeset에서 변경 파일 목록 수집
                    def changedFiles = []
                    currentBuild.changeSets.each { cs ->
                        cs.items.each { item ->
                            item.affectedFiles.each { af -> changedFiles << af.path }
                        }
                    }
                    // changeset이 비어있으면 git diff로 fallback
                    if (!changedFiles) {
                        def diff = sh(
                            script: "cd ${PROJECT_PATH} && git diff --name-only HEAD~1 HEAD || true",
                            returnStdout: true
                        ).trim()
                        if (diff) changedFiles = diff.split('\n') as List
                    }

                    echo "Changed files:\n${changedFiles.join('\n')}"

                    if (!changedFiles) {
                        echo 'No changes detected; assuming full change.'
                        env.BE_CHANGED = 'true'
                        env.FE_CHANGED = 'true'
                        env.FP_CHANGED = 'true'
                        env.INFRA_CHANGED = 'true'
                    } else {
                        env.BE_CHANGED    = changedFiles.any { it.startsWith('src/BE/') } ? 'true' : 'false'
                        env.FE_CHANGED    = changedFiles.any { it.startsWith('src/FE/') && !it.startsWith('src/FE-phone/') } ? 'true' : 'false'
                        env.FP_CHANGED    = changedFiles.any { it.startsWith('src/FE-phone/') } ? 'true' : 'false'
                        env.INFRA_CHANGED = changedFiles.any { it.startsWith('infra/') || it == 'Jenkinsfile' } ? 'true' : 'false'
                    }

                    echo "BE_CHANGED: ${env.BE_CHANGED}"
                    echo "FE_CHANGED: ${env.FE_CHANGED}"
                    echo "FP_CHANGED: ${env.FP_CHANGED}"
                    echo "INFRA_CHANGED: ${env.INFRA_CHANGED}"
                }
            }
        }

        // 백엔드 변경 시 테스트 실행 (병렬 확장 가능)
        stage('Quality Gate') {
            parallel {
                stage('BE Test') {
                    when { expression { env.BE_CHANGED == 'true' } }
                    steps {
                        echo '=== Running Backend Tests ==='
                        sh '''
                            cd ${PROJECT_PATH}/src/BE && \
                            chmod +x ./gradlew && \
                            ./gradlew test --no-daemon -PskipIntegrationTests=true
                        '''
                    }
                }
            }
        }

        // 변경된 서비스만 Docker buildx로 빌드 후 DockerHub에 push (병렬)
        stage('Build & Push') {
            parallel {
                stage('Backend') {
                    when { expression { env.BE_CHANGED == 'true' } }
                    steps {
                        echo '=== Docker Build & Push Backend ==='
                        withDockerRegistry([credentialsId: 'dockerhub-credentials', url: '']) {
                            sh '''
                                docker buildx use ${BUILDX_BUILDER}-be 2>/dev/null || \
                                docker buildx create --name ${BUILDX_BUILDER}-be --driver docker-container --bootstrap --use
                                cd ${PROJECT_PATH}/src/BE && \
                                docker buildx build \
                                  --builder ${BUILDX_BUILDER}-be \
                                  --tag ${DOCKER_IMAGE_BE}:${BUILD_NUMBER} \
                                  --tag ${DOCKER_IMAGE_BE}:latest \
                                  --push .
                            '''
                        }
                    }
                }

                stage('Frontend') {
                    when { expression { env.FE_CHANGED == 'true' } }
                    steps {
                        echo '=== Docker Build & Push Frontend ==='
                        withDockerRegistry([credentialsId: 'dockerhub-credentials', url: '']) {
                            sh '''
                                docker buildx use ${BUILDX_BUILDER}-fe 2>/dev/null || \
                                docker buildx create --name ${BUILDX_BUILDER}-fe --driver docker-container --bootstrap --use
                                cd ${PROJECT_PATH}/src/FE && \
                                docker buildx build \
                                  --builder ${BUILDX_BUILDER}-fe \
                                  --build-arg VITE_API_URL=/api \
                                  --tag ${DOCKER_IMAGE_FE}:${BUILD_NUMBER} \
                                  --tag ${DOCKER_IMAGE_FE}:latest \
                                  --push .
                            '''
                        }
                    }
                }

                stage('Phone') {
                    when { expression { env.FP_CHANGED == 'true' } }
                    steps {
                        echo '=== Docker Build & Push Phone ==='
                        withDockerRegistry([credentialsId: 'dockerhub-credentials', url: '']) {
                            sh '''
                                docker buildx use ${BUILDX_BUILDER}-fp 2>/dev/null || \
                                docker buildx create --name ${BUILDX_BUILDER}-fp --driver docker-container --bootstrap --use
                                cd ${PROJECT_PATH}/src/FE-phone && \
                                docker buildx build \
                                  --builder ${BUILDX_BUILDER}-fp \
                                  --build-arg VITE_API_BASE_URL=/api/v1 \
                                  --tag ${DOCKER_IMAGE_FP}:${BUILD_NUMBER} \
                                  --tag ${DOCKER_IMAGE_FP}:latest \
                                  --push .
                            '''
                        }
                    }
                }
            }
        }

        stage('Deploy') {
            when {
                expression {
                    env.BE_CHANGED == 'true' || env.FE_CHANGED == 'true' ||
                    env.FP_CHANGED == 'true' || env.INFRA_CHANGED == 'true'
                }
            }
            steps {
                script {
                    // 변경되지 않은 서비스는 현재 실행 중인 이미지 태그를 유지
                    def resolveRunningTag = { service, fallback ->
                        def imageRef = sh(
                            script: """
                                cd ${PROJECT_PATH}/infra
                                CID=\$(docker compose --env-file ${PROD_ENV_FILE} -f docker-compose.prod.yml ps -q ${service} || true)
                                if [ -n "\$CID" ]; then
                                  docker inspect --format='{{.Config.Image}}' "\$CID" 2>/dev/null || true
                                fi
                            """,
                            returnStdout: true
                        ).trim()

                        if (!imageRef || imageRef.contains('@')) return fallback
                        int colon = imageRef.lastIndexOf(':')
                        int slash = imageRef.lastIndexOf('/')
                        if (colon <= slash) return fallback
                        return imageRef.substring(colon + 1)
                    }

                    def beTag = (env.BE_CHANGED == 'true') ? env.BUILD_NUMBER : resolveRunningTag('spring-api', 'latest')
                    def feTag = (env.FE_CHANGED == 'true') ? env.BUILD_NUMBER : resolveRunningTag('frontend', 'latest')
                    def fpTag = (env.FP_CHANGED == 'true') ? env.BUILD_NUMBER : resolveRunningTag('frontend-phone', 'latest')

                    echo "Deploy image tags -> backend: ${beTag}, frontend: ${feTag}, phone: ${fpTag}"

                    // docker-compose.prod.yml의 이미지 태그 변수로 전달
                    withEnv([
                        "BE_IMAGE_TAG=${beTag}",
                        "FE_IMAGE_TAG=${feTag}",
                        "FP_IMAGE_TAG=${fpTag}"
                    ]) {
                        // infra 변경 시 전체 서비스 재시작, 아니면 변경 서비스만 업데이트
                        if (env.INFRA_CHANGED == 'true') {
                            echo '=== Deploying (infra change - full restart) ==='
                            sh '''
                                cd ${PROJECT_PATH}/infra && \
                                docker compose --env-file ${PROD_ENV_FILE} -f docker-compose.prod.yml pull && \
                                docker compose --env-file ${PROD_ENV_FILE} -f docker-compose.prod.yml up -d
                            '''
                        } else {
                            def services = []
                            if (env.BE_CHANGED == 'true') services << 'spring-api'
                            if (env.FE_CHANGED == 'true') services << 'frontend'
                            if (env.FP_CHANGED == 'true') services << 'frontend-phone'

                            if (services) {
                                def svc = services.join(' ')
                                echo "=== Deploying services: ${svc} ==="
                                sh """
                                    cd ${PROJECT_PATH}/infra && \
                                    docker compose --env-file ${PROD_ENV_FILE} -f docker-compose.prod.yml pull ${svc} && \
                                    docker compose --env-file ${PROD_ENV_FILE} -f docker-compose.prod.yml up -d --no-deps ${svc}
                                """
                            } else {
                                echo 'No services to deploy.'
                            }
                        }
                    }

                    echo '=== Checking Container Status ==='
                    sh '''
                        cd ${PROJECT_PATH}/infra && \
                        docker compose --env-file ${PROD_ENV_FILE} -f docker-compose.prod.yml ps
                    '''
                }
            }
        }
    }

    post {
        success {
            script {
                def msg = 'CI/CD Pipeline 성공!'
                if (env.BE_CHANGED == 'true') msg += ' [Backend]'
                if (env.FE_CHANGED == 'true') msg += ' [Frontend]'
                if (env.FP_CHANGED == 'true') msg += ' [Phone]'
                if (env.INFRA_CHANGED == 'true') msg += ' [Infra]'
                echo msg
            }
        }
        failure {
            echo 'CI/CD Pipeline 실패!'
            echo '=== Recent Logs (on failure) ==='
            sh '''
                cd ${PROJECT_PATH}/infra && \
                docker compose --env-file ${PROD_ENV_FILE} -f docker-compose.prod.yml logs --tail=200 || true
            '''
        }
        always {
            sh '''
                echo "=== Cleaning up dangling images ==="
                docker image prune -f || true
            '''
        }
    }
}

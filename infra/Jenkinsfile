/**
 * Waddoc CI/CD Pipeline
 *
 * 배포 흐름:
 *   1. GitLab (dev 브랜치 - 추후 master로 수정) push
 *   2. Jenkins agent(EC2)에서 코드 checkout
 *   3. 변경 감지: src/BE 모듈(core-app/edge-bff/notification-service/robot-gateway), src/FE, src/FE-phone, infra 중 변경된 부분만 처리
 *      - infra/nginx 및 앱 이미지(src/BE, src/FE, src/FE-phone) 변경은 nginx 재시작
 *   4. 변경된 이미지 서비스만 Docker buildx → DockerHub push
 *   5. docker compose pull/build → up -d
 *      - 변경된 서비스만 교체
 *      - 운영 앱 이미지는 latest 대신 BUILD_NUMBER 기반 불변 태그를 사용
 *      - core-app 또는 infra 변경 시에만 core-app replica 수를 3개로 보정
 *
 * 필요한 Jenkins Credentials:
 *   - gitlab-deploy-token  : GitLab Deploy Token (Username+Password)
 *   - dockerhub-credentials : DockerHub 계정
 */
pipeline {
    agent { label 'deploy' }  // EC2(j14a603.p.ssafy.io)에 설치된 Jenkins agent

    options {
        // checkout 단계에서 직접 git 설정을 제어하므로 기본 checkout은 끈다.
        skipDefaultCheckout(true)
        // 콘솔 로그에 시각을 남겨 배포 시간 추적을 쉽게 한다.
        timestamps()
        disableConcurrentBuilds()              // 동시 빌드 방지
        // 장시간 hang을 막기 위한 파이프라인 전체 제한 시간
        timeout(time: 30, unit: 'MINUTES')
        // 최근 빌드 기록만 유지해 Jenkins 디스크 사용량을 제한한다.
        buildDiscarder(logRotator(numToKeepStr: '30', daysToKeepStr: '14'))
    }

    environment {
        // 현재 자동 배포 대상 브랜치
        BRANCH = 'dev'
        // DockerHub 이미지 이름
        DOCKER_IMAGE_CORE_APP = 'hwan515/waddoc-backend'
        DOCKER_IMAGE_EDGE_BFF = 'hwan515/waddoc-edge-bff'
        DOCKER_IMAGE_NOTIFICATION = 'hwan515/waddoc-notification'
        DOCKER_IMAGE_ROBOT_GATEWAY = 'hwan515/waddoc-robot-gateway'
        DOCKER_IMAGE_FE = 'hwan515/waddoc-frontend'
        DOCKER_IMAGE_FP = 'hwan515/waddoc-phone'
        // 운영에서 유지할 backend 컨테이너 수
        CORE_APP_REPLICAS = '3'
        PROJECT_PATH = '/home/ubuntu/S14P21A603'   // EC2 내 프로젝트 경로
        // 운영 환경변수 파일(.env)은 서버 로컬 파일을 사용한다.
        PROD_ENV_FILE = '/home/ubuntu/.waddoc/prod.env'
        COMPOSE_FILES = '-f docker-compose.prod.yml -f docker-compose.monitoring.prod.yml'
        DOCKER_BUILDKIT = '1'
        BUILDX_BUILDER = 'waddoc-builder'          // buildx 빌더 이름 접두사
        NODE_BUILD_IMAGE = 'node:22-alpine'       // FE 품질 게이트는 에이전트 호스트 Node 버전과 분리한다.
    }

    stages {
        // GitLab Deploy Token으로 소스 코드 checkout
        stage('Checkout') {
            steps {
                dir("${PROJECT_PATH}") {
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: "*/${BRANCH}"]],
                        userRemoteConfigs: [[
                            url: 'https://lab.ssafy.com/s14-mobility-smarthome-sub1/S14P21A603.git',
                            credentialsId: 'gitlab-deploy-token'
                        ]],
                        extensions: [
                            // 배포 서버 워크스페이스에 남아 있을 수 있는 이전 파일을 제거한다.
                            [$class: 'CleanBeforeCheckout'],
                            // 배포에는 최근 이력만 필요하므로 shallow clone으로 속도를 줄인다.
                            [$class: 'CloneOption', shallow: true, depth: 50]
                        ]
                    ])
                }
            }
        }

        // 변경된 파일 경로 기반으로 어떤 서비스를 빌드/배포할지 결정
        stage('Compute Changes') {
            steps {
                script {
                    // Jenkins changeset에서 변경 파일 목록 수집
                    def changedFiles = []
                    currentBuild.changeSets.each { cs ->
                        cs.items.each { item ->
                            item.affectedFiles.each { af -> changedFiles << af.path }
                        }
                    }
                    // changeset이 비어있으면 git diff로 fallback
                    if (!changedFiles) {
                        def diff = sh(
                            script: "cd ${PROJECT_PATH} && git diff --name-only HEAD~1 HEAD || true",
                            returnStdout: true
                        ).trim()
                        if (diff) changedFiles = diff.split('\n') as List
                    }

                    echo "Changed files:\n${changedFiles.join('\n')}"

                    if (!changedFiles) {
                        echo 'No changes detected; assuming full change.'
                        // 변경 파일을 신뢰할 수 없으면 전체 서비스를 다시 배포 대상으로 본다.
                        env.BE_CHANGED = 'true'
                        env.CORE_APP_CHANGED = 'true'
                        env.EDGE_BFF_CHANGED = 'true'
                        env.NOTIFICATION_CHANGED = 'true'
                        env.ROBOT_GATEWAY_CHANGED = 'true'
                        env.FE_CHANGED = 'true'
                        env.FP_CHANGED = 'true'
                        env.INFRA_CHANGED = 'true'
                        env.MONITORING_CHANGED = 'true'
                        env.NGINX_CHANGED = 'true'
                    } else {
                        def backendSharedChanged = changedFiles.any {
                            it == 'src/BE/build.gradle.kts' ||
                            it == 'src/BE/settings.gradle.kts' ||
                            it == 'src/BE/gradlew' ||
                            it == 'src/BE/gradlew.bat' ||
                            it == 'src/BE/Dockerfile' ||
                            it.startsWith('src/BE/gradle/') ||
                            it.startsWith('src/BE/shared-kernel/')
                        }
                        def coreAppChanged = changedFiles.any { it.startsWith('src/BE/core-app/') }
                        def edgeBffChanged = changedFiles.any { it.startsWith('src/BE/edge-bff/') }
                        def notificationChanged = changedFiles.any { it.startsWith('src/BE/notification-service/') }
                        def robotGatewayChanged = changedFiles.any { it.startsWith('src/BE/robot-gateway/') }

                        env.SHARED_KERNEL_CHANGED = backendSharedChanged ? 'true' : 'false'
                        env.CORE_APP_CHANGED = (backendSharedChanged || coreAppChanged) ? 'true' : 'false'
                        env.EDGE_BFF_CHANGED = (backendSharedChanged || edgeBffChanged) ? 'true' : 'false'
                        env.NOTIFICATION_CHANGED = (backendSharedChanged || notificationChanged) ? 'true' : 'false'
                        env.ROBOT_GATEWAY_CHANGED = (backendSharedChanged || robotGatewayChanged) ? 'true' : 'false'
                        env.BE_CHANGED = (
                                env.CORE_APP_CHANGED == 'true' ||
                                env.EDGE_BFF_CHANGED == 'true' ||
                                env.NOTIFICATION_CHANGED == 'true' ||
                                env.ROBOT_GATEWAY_CHANGED == 'true'
                        ) ? 'true' : 'false'
                        env.FE_CHANGED    = changedFiles.any { it.startsWith('src/FE/') && !it.startsWith('src/FE-phone/') } ? 'true' : 'false'
                        env.FP_CHANGED    = changedFiles.any { it.startsWith('src/FE-phone/') } ? 'true' : 'false'
                        env.MONITORING_CHANGED = changedFiles.any {
                            it == 'infra/docker-compose.monitoring.prod.yml' || it.startsWith('infra/monitoring/')
                        } ? 'true' : 'false'
                        env.NGINX_CHANGED = changedFiles.any { it.startsWith('infra/nginx/') } ? 'true' : 'false'
                        // Jenkinsfile 변경만으로 운영 스택 전체 재기동이 일어나지 않도록 제외한다.
                        env.INFRA_CHANGED = changedFiles.any {
                            it.startsWith('infra/') &&
                            it != 'infra/Jenkinsfile' &&
                            !it.startsWith('infra/nginx/') &&
                            it != 'infra/docker-compose.monitoring.prod.yml' &&
                            !it.startsWith('infra/monitoring/')
                        } ? 'true' : 'false'
                    }

                    echo "BE_CHANGED: ${env.BE_CHANGED}"
                    echo "CORE_APP_CHANGED: ${env.CORE_APP_CHANGED}"
                    echo "EDGE_BFF_CHANGED: ${env.EDGE_BFF_CHANGED}"
                    echo "NOTIFICATION_CHANGED: ${env.NOTIFICATION_CHANGED}"
                    echo "ROBOT_GATEWAY_CHANGED: ${env.ROBOT_GATEWAY_CHANGED}"
                    echo "FE_CHANGED: ${env.FE_CHANGED}"
                    echo "FP_CHANGED: ${env.FP_CHANGED}"
                    echo "MONITORING_CHANGED: ${env.MONITORING_CHANGED}"
                    echo "NGINX_CHANGED: ${env.NGINX_CHANGED}"
                    echo "INFRA_CHANGED: ${env.INFRA_CHANGED}"
                }
            }
        }

        // 백엔드 품질 검사는 같은 워크스페이스의 Gradle 충돌을 피하기 위해 모듈별로 순차 실행한다.
        stage('Quality Gate') {
            parallel {
                stage('Backend Quality Gate') {
                    when { expression { env.BE_CHANGED == 'true' } }
                    stages {
                        stage('Shared Kernel Test') {
                            when { expression { env.SHARED_KERNEL_CHANGED == 'true' } }
                            steps {
                                echo '=== Running Shared Kernel Tests ==='
                                withEnv(['APP_SEED_DEFAULT_PASSWORD=ci-seed-password']) {
                                    sh '''
                                        # 공통 Gradle 설정이나 shared-kernel 변경이 있으면 먼저 공통 모듈 테스트를 확인한다.
                                        cd ${PROJECT_PATH}/src/BE && \
                                        chmod +x ./gradlew && \
                                        ./gradlew :shared-kernel:test --no-daemon -PskipIntegrationTests=true
                                    '''
                                }
                            }
                        }

                        stage('Core App Test') {
                            when { expression { env.CORE_APP_CHANGED == 'true' } }
                            steps {
                                echo '=== Running Core App Tests ==='
                                withEnv(['APP_SEED_DEFAULT_PASSWORD=ci-seed-password']) {
                                    sh '''
                                        # 통합 테스트는 외부 인프라 의존도가 높아 CI 기본 경로에서는 제외한다.
                                        cd ${PROJECT_PATH}/src/BE && \
                                        chmod +x ./gradlew && \
                                        ./gradlew :core-app:test --no-daemon -PskipIntegrationTests=true
                                    '''
                                }
                            }
                        }

                        stage('Edge BFF Test') {
                            when { expression { env.EDGE_BFF_CHANGED == 'true' } }
                            steps {
                                echo '=== Running Edge BFF Tests ==='
                                withEnv(['APP_SEED_DEFAULT_PASSWORD=ci-seed-password']) {
                                    sh '''
                                        cd ${PROJECT_PATH}/src/BE && \
                                        chmod +x ./gradlew && \
                                        ./gradlew :edge-bff:test --no-daemon -PskipIntegrationTests=true
                                    '''
                                }
                            }
                        }

                        stage('Notification Service Test') {
                            when { expression { env.NOTIFICATION_CHANGED == 'true' } }
                            steps {
                                echo '=== Running Notification Service Tests ==='
                                withEnv(['APP_SEED_DEFAULT_PASSWORD=ci-seed-password']) {
                                    sh '''
                                        cd ${PROJECT_PATH}/src/BE && \
                                        chmod +x ./gradlew && \
                                        ./gradlew :notification-service:test --no-daemon -PskipIntegrationTests=true
                                    '''
                                }
                            }
                        }

                        stage('Robot Gateway Test') {
                            when { expression { env.ROBOT_GATEWAY_CHANGED == 'true' } }
                            steps {
                                echo '=== Running Robot Gateway Tests ==='
                                withEnv(['APP_SEED_DEFAULT_PASSWORD=ci-seed-password']) {
                                    sh '''
                                        cd ${PROJECT_PATH}/src/BE && \
                                        chmod +x ./gradlew && \
                                        ./gradlew :robot-gateway:test --no-daemon -PskipIntegrationTests=true
                                    '''
                                }
                            }
                        }
                    }
                }

                stage('FE Lint & Build') {
                    when { expression { env.FE_CHANGED == 'true' } }
                    steps {
                        echo '=== Running Frontend Lint & Build ==='
                        sh '''
                            LOCAL_UID="$(id -u)"
                            LOCAL_GID="$(id -g)"
                            docker run --rm \
                              --user "${LOCAL_UID}:${LOCAL_GID}" \
                              --env HOME=/tmp \
                              --env npm_config_cache=/tmp/.npm \
                              --volume "${PROJECT_PATH}/src/FE:/app" \
                              --workdir /app \
                              ${NODE_BUILD_IMAGE} \
                              sh -lc 'npm ci --no-audit --no-fund && npm run lint && npm run build'
                        '''
                    }
                }

                stage('Phone Lint & Build') {
                    when { expression { env.FP_CHANGED == 'true' } }
                    steps {
                        echo '=== Running FE-phone Lint & Build ==='
                        sh '''
                            LOCAL_UID="$(id -u)"
                            LOCAL_GID="$(id -g)"
                            docker run --rm \
                              --user "${LOCAL_UID}:${LOCAL_GID}" \
                              --env HOME=/tmp \
                              --env npm_config_cache=/tmp/.npm \
                              --volume "${PROJECT_PATH}/src/FE-phone:/app" \
                              --workdir /app \
                              ${NODE_BUILD_IMAGE} \
                              sh -lc 'npm ci --no-audit --no-fund && npm run lint && npm run build'
                        '''
                    }
                }
            }
        }

        // 변경된 서비스만 Docker buildx로 빌드 후 DockerHub에 push (병렬)
        stage('Build & Push') {
            parallel {
                stage('Core App') {
                    when { expression { env.CORE_APP_CHANGED == 'true' } }
                    steps {
                        echo '=== Docker Build & Push Core App ==='
                        withDockerRegistry([credentialsId: 'dockerhub-credentials', url: '']) {
                            sh '''
                                docker buildx use ${BUILDX_BUILDER}-core-app 2>/dev/null || \
                                docker buildx create --name ${BUILDX_BUILDER}-core-app --driver docker-container --bootstrap --use
                                cd ${PROJECT_PATH}/src/BE && \
                                docker buildx build \
                                  --builder ${BUILDX_BUILDER}-core-app \
                                  --build-arg MODULE_NAME=core-app \
                                  --tag ${DOCKER_IMAGE_CORE_APP}:${BUILD_NUMBER} \
                                  --push .
                            '''
                        }
                    }
                }

                stage('Edge BFF') {
                    when { expression { env.EDGE_BFF_CHANGED == 'true' } }
                    steps {
                        echo '=== Docker Build & Push Edge BFF ==='
                        withDockerRegistry([credentialsId: 'dockerhub-credentials', url: '']) {
                            sh '''
                                docker buildx use ${BUILDX_BUILDER}-edge-bff 2>/dev/null || \
                                docker buildx create --name ${BUILDX_BUILDER}-edge-bff --driver docker-container --bootstrap --use
                                cd ${PROJECT_PATH}/src/BE && \
                                docker buildx build \
                                  --builder ${BUILDX_BUILDER}-edge-bff \
                                  --build-arg MODULE_NAME=edge-bff \
                                  --tag ${DOCKER_IMAGE_EDGE_BFF}:${BUILD_NUMBER} \
                                  --push .
                            '''
                        }
                    }
                }

                stage('Notification Service') {
                    when { expression { env.NOTIFICATION_CHANGED == 'true' } }
                    steps {
                        echo '=== Docker Build & Push Notification Service ==='
                        withDockerRegistry([credentialsId: 'dockerhub-credentials', url: '']) {
                            sh '''
                                docker buildx use ${BUILDX_BUILDER}-notification-service 2>/dev/null || \
                                docker buildx create --name ${BUILDX_BUILDER}-notification-service --driver docker-container --bootstrap --use
                                cd ${PROJECT_PATH}/src/BE && \
                                docker buildx build \
                                  --builder ${BUILDX_BUILDER}-notification-service \
                                  --build-arg MODULE_NAME=notification-service \
                                  --tag ${DOCKER_IMAGE_NOTIFICATION}:${BUILD_NUMBER} \
                                  --push .
                            '''
                        }
                    }
                }

                stage('Robot Gateway') {
                    when { expression { env.ROBOT_GATEWAY_CHANGED == 'true' } }
                    steps {
                        echo '=== Docker Build & Push Robot Gateway ==='
                        withDockerRegistry([credentialsId: 'dockerhub-credentials', url: '']) {
                            sh '''
                                docker buildx use ${BUILDX_BUILDER}-robot-gateway 2>/dev/null || \
                                docker buildx create --name ${BUILDX_BUILDER}-robot-gateway --driver docker-container --bootstrap --use
                                cd ${PROJECT_PATH}/src/BE && \
                                docker buildx build \
                                  --builder ${BUILDX_BUILDER}-robot-gateway \
                                  --build-arg MODULE_NAME=robot-gateway \
                                  --tag ${DOCKER_IMAGE_ROBOT_GATEWAY}:${BUILD_NUMBER} \
                                  --push .
                            '''
                        }
                    }
                }

                stage('Frontend') {
                    when { expression { env.FE_CHANGED == 'true' } }
                    steps {
                        echo '=== Docker Build & Push Frontend ==='
                        withDockerRegistry([credentialsId: 'dockerhub-credentials', url: '']) {
                            sh '''
                                docker buildx use ${BUILDX_BUILDER}-fe 2>/dev/null || \
                                docker buildx create --name ${BUILDX_BUILDER}-fe --driver docker-container --bootstrap --use
                                cd ${PROJECT_PATH}/src/FE && \
                                # 운영 Nginx가 /api 로 프록시하므로 정적 빌드는 상대 API 경로를 사용한다.
                                docker buildx build \
                                  --builder ${BUILDX_BUILDER}-fe \
                                  --build-arg VITE_API_URL=/api \
                                  --tag ${DOCKER_IMAGE_FE}:${BUILD_NUMBER} \
                                  --push .
                            '''
                        }
                    }
                }

                stage('Phone') {
                    when { expression { env.FP_CHANGED == 'true' } }
                    steps {
                        echo '=== Docker Build & Push Phone ==='
                        withDockerRegistry([credentialsId: 'dockerhub-credentials', url: '']) {
                            sh '''
                                docker buildx use ${BUILDX_BUILDER}-fp 2>/dev/null || \
                                docker buildx create --name ${BUILDX_BUILDER}-fp --driver docker-container --bootstrap --use
                                cd ${PROJECT_PATH}/src/FE-phone && \
                                # phone 앱은 /phone 하위 경로로 서비스되므로 base path를 함께 고정한다.
                                docker buildx build \
                                  --builder ${BUILDX_BUILDER}-fp \
                                  --build-arg VITE_API_BASE_URL=/api/v1 \
                                  --build-arg VITE_BASE_PATH=/phone/ \
                                  --tag ${DOCKER_IMAGE_FP}:${BUILD_NUMBER} \
                                  --push .
                            '''
                        }
                    }
                }
            }
        }

        stage('Deploy') {
            when {
                expression {
                    env.BE_CHANGED == 'true' || env.FE_CHANGED == 'true' ||
                    env.FP_CHANGED == 'true' ||
                    env.MONITORING_CHANGED == 'true' || env.NGINX_CHANGED == 'true' || env.INFRA_CHANGED == 'true'
                }
            }
            steps {
                script {
                    def monitoringServices = 'prometheus grafana cadvisor postgres-exporter notification-postgres-exporter redis-exporter notification-redis-exporter robot-redis-exporter kafka-exporter'
                    def pullableServices = sh(
                            script: """
                                cd ${PROJECT_PATH}/infra
                                docker compose --env-file ${PROD_ENV_FILE} ${COMPOSE_FILES} config --services \
                                  | grep -vx 'ros2_app_ec2' \
                                  | tr '\\n' ' '
                            """,
                            returnStdout: true
                    ).trim()

                    // 변경되지 않은 서비스는 현재 컨테이너 또는 prod.env에 고정된 불변 태그를 그대로 사용한다.
                    def resolveConfiguredTag = { tagKey ->
                        def configuredTag = sh(
                                script: """
                                    if [ -f ${PROD_ENV_FILE} ]; then
                                      grep -E '^${tagKey}=' ${PROD_ENV_FILE} | tail -n 1 | cut -d= -f2- || true
                                    fi
                                """,
                                returnStdout: true
                        ).trim()

                        return configuredTag
                    }

                    def resolveRunningTag = { service, tagKey ->
                        def imageRef = sh(
                            script: """
                                cd ${PROJECT_PATH}/infra
                                # scale된 서비스는 여러 컨테이너가 나올 수 있으므로 첫 컨테이너 기준으로 태그를 읽는다.
                                CID=\$(docker compose --env-file ${PROD_ENV_FILE} ${COMPOSE_FILES} ps -q ${service} | head -n 1 || true)
                                if [ -n "\$CID" ]; then
                                  docker inspect --format='{{.Config.Image}}' "\$CID" 2>/dev/null || true
                                fi
                            """,
                            returnStdout: true
                        ).trim()

                        if (!imageRef || imageRef.contains('@')) {
                            def configuredTag = resolveConfiguredTag(tagKey)
                            if (configuredTag) {
                                return configuredTag
                            }
                            error("Unable to resolve image tag for unchanged service '${service}'. Set ${tagKey} in ${PROD_ENV_FILE} or redeploy the service.")
                        }
                        int colon = imageRef.lastIndexOf(':')
                        int slash = imageRef.lastIndexOf('/')
                        if (colon <= slash) {
                            def configuredTag = resolveConfiguredTag(tagKey)
                            if (configuredTag) {
                                return configuredTag
                            }
                            error("Unable to parse image tag for unchanged service '${service}'. Set ${tagKey} in ${PROD_ENV_FILE} or redeploy the service.")
                        }
                        return imageRef.substring(colon + 1)
                    }

                    def coreAppTag = (env.CORE_APP_CHANGED == 'true') ? env.BUILD_NUMBER : resolveRunningTag('core-app', 'CORE_APP_IMAGE_TAG')
                    def edgeBffTag = (env.EDGE_BFF_CHANGED == 'true') ? env.BUILD_NUMBER : resolveRunningTag('edge-bff', 'EDGE_BFF_IMAGE_TAG')
                    def notificationTag = (env.NOTIFICATION_CHANGED == 'true') ? env.BUILD_NUMBER : resolveRunningTag('notification-service', 'NOTIFICATION_IMAGE_TAG')
                    def robotGatewayTag = (env.ROBOT_GATEWAY_CHANGED == 'true') ? env.BUILD_NUMBER : resolveRunningTag('robot-gateway', 'ROBOT_GATEWAY_IMAGE_TAG')
                    def feTag = (env.FE_CHANGED == 'true') ? env.BUILD_NUMBER : resolveRunningTag('frontend', 'FE_IMAGE_TAG')
                    def fpTag = (env.FP_CHANGED == 'true') ? env.BUILD_NUMBER : resolveRunningTag('frontend-phone', 'FP_IMAGE_TAG')

                    // 부분 배포 시 변경되지 않은 서비스가 latest로 덮어써지지 않도록 현재 불변 태그를 그대로 유지한다.
                    echo "Deploy image tags -> core-app: ${coreAppTag}, edge-bff: ${edgeBffTag}, notification: ${notificationTag}, robot-gateway: ${robotGatewayTag}, frontend: ${feTag}, phone: ${fpTag}"

                    // compose가 새 이미지 태그를 사용하도록 환경변수로 주입
                    withEnv([
                        "CORE_APP_IMAGE_TAG=${coreAppTag}",
                        "EDGE_BFF_IMAGE_TAG=${edgeBffTag}",
                        "NOTIFICATION_IMAGE_TAG=${notificationTag}",
                        "ROBOT_GATEWAY_IMAGE_TAG=${robotGatewayTag}",
                        "FE_IMAGE_TAG=${feTag}",
                        "FP_IMAGE_TAG=${fpTag}"
                    ]) {
                        // infra 변경이면 전체 스택 재기동, 아니면 변경된 서비스만 갱신
                        if (env.INFRA_CHANGED == 'true') {
                            echo '=== Deploying (infra change - full restart) ==='
                            sh '''
                                docker buildx use ${BUILDX_BUILDER} 2>/dev/null || \
                                docker buildx create --name ${BUILDX_BUILDER} --driver docker-container --bootstrap --use
                                cd ${PROJECT_PATH}/infra && \
                                docker compose --env-file ${PROD_ENV_FILE} ${COMPOSE_FILES} pull ${pullableServices} && \
                                docker compose --env-file ${PROD_ENV_FILE} ${COMPOSE_FILES} up -d --build --scale core-app=${CORE_APP_REPLICAS}
                            '''
                        } else {
                            def pullServices = []
                            def buildServices = []
                            def deployServices = []

                            if (env.CORE_APP_CHANGED == 'true') {
                                pullServices << 'core-app'
                                deployServices << 'core-app'
                            }
                            if (env.EDGE_BFF_CHANGED == 'true') {
                                pullServices << 'edge-bff'
                                deployServices << 'edge-bff'
                            }
                            if (env.NOTIFICATION_CHANGED == 'true') {
                                pullServices << 'notification-service'
                                deployServices << 'notification-service'
                            }
                            if (env.ROBOT_GATEWAY_CHANGED == 'true') {
                                pullServices << 'robot-gateway'
                                deployServices << 'robot-gateway'
                            }
                            if (env.FE_CHANGED == 'true') {
                                pullServices << 'frontend'
                                deployServices << 'frontend'
                            }
                            if (env.FP_CHANGED == 'true') {
                                pullServices << 'frontend-phone'
                                deployServices << 'frontend-phone'
                            }
                            if (deployServices) {
                                def svc = deployServices.join(' ')
                                def pullSvc = pullServices.join(' ')
                                // backend가 배포 대상이면 core-app을 3개로 맞춘다
                                def scaleArg = deployServices.contains('core-app')
                                        ? "--scale core-app=${env.CORE_APP_REPLICAS}"
                                        : ''
                                def buildArg = buildServices ? '--build' : ''
                                echo "=== Deploying services: ${svc} ==="
                                if (pullServices) {
                                    sh """
                                        cd ${PROJECT_PATH}/infra && \
                                        docker compose --env-file ${PROD_ENV_FILE} ${COMPOSE_FILES} pull ${pullSvc}
                                    """
                                }
                                sh """
                                    cd ${PROJECT_PATH}/infra && \
                                    docker compose --env-file ${PROD_ENV_FILE} ${COMPOSE_FILES} up -d --no-deps ${buildArg} ${scaleArg} ${svc}
                                """
                            } else {
                                echo 'No services to deploy.'
                            }

                            if (env.MONITORING_CHANGED == 'true') {
                                echo '=== Deploying monitoring services ==='
                                sh """
                                    cd ${PROJECT_PATH}/infra && \
                                    docker compose --env-file ${PROD_ENV_FILE} ${COMPOSE_FILES} pull ${monitoringServices} && \
                                    docker compose --env-file ${PROD_ENV_FILE} ${COMPOSE_FILES} up -d --no-deps ${monitoringServices}
                                """
                            }

                            def shouldRestartNginx =
                                    env.NGINX_CHANGED == 'true' ||
                                    env.CORE_APP_CHANGED == 'true' ||
                                    env.EDGE_BFF_CHANGED == 'true' ||
                                    env.NOTIFICATION_CHANGED == 'true' ||
                                    env.ROBOT_GATEWAY_CHANGED == 'true' ||
                                    env.FE_CHANGED == 'true' ||
                                    env.FP_CHANGED == 'true'

                            if (shouldRestartNginx) {
                                echo '=== Restarting nginx (nginx/app change) ==='
                                sh '''
                                    cd ${PROJECT_PATH}/infra && \
                                    docker compose --env-file ${PROD_ENV_FILE} ${COMPOSE_FILES} restart nginx
                                '''
                            }
                        }

                        if (env.CORE_APP_CHANGED == 'true' && env.INFRA_CHANGED != 'true') {
                            // 다른 서비스만 배포할 때는 core-app을 건드리지 않고, core-app 자체를 배포할 때만 replica 수를 맞춘다.
                            echo "=== Ensuring core-app replicas: ${CORE_APP_REPLICAS} ==="
                            sh '''
                                cd ${PROJECT_PATH}/infra && \
                                docker compose --env-file ${PROD_ENV_FILE} ${COMPOSE_FILES} up -d --no-deps --scale core-app=${CORE_APP_REPLICAS} core-app
                            '''
                        }
                    }

                    echo '=== Checking Container Status ==='
                    sh '''
                        cd ${PROJECT_PATH}/infra && \
                        docker compose --env-file ${PROD_ENV_FILE} ${COMPOSE_FILES} ps
                    '''
                }
            }
        }
    }

    post {
        success {
            script {
                // 어떤 영역이 실제로 반영됐는지 성공 로그에 남긴다.
                def msg = 'CI/CD Pipeline 성공!'
                if (env.CORE_APP_CHANGED == 'true') msg += ' [CoreApp]'
                if (env.EDGE_BFF_CHANGED == 'true') msg += ' [EdgeBff]'
                if (env.NOTIFICATION_CHANGED == 'true') msg += ' [Notification]'
                if (env.ROBOT_GATEWAY_CHANGED == 'true') msg += ' [RobotGateway]'
                if (env.FE_CHANGED == 'true') msg += ' [Frontend]'
                if (env.FP_CHANGED == 'true') msg += ' [Phone]'
                if (env.MONITORING_CHANGED == 'true') msg += ' [Monitoring]'
                if (env.NGINX_CHANGED == 'true') msg += ' [Nginx]'
                if (env.INFRA_CHANGED == 'true') msg += ' [Infra]'
                echo msg
            }
        }
        failure {
            echo 'CI/CD Pipeline 실패!'
            echo '=== Recent Logs (on failure) ==='
            sh '''
                # 실패 시 최근 compose 로그를 바로 확인할 수 있게 출력한다.
                cd ${PROJECT_PATH}/infra && \
                docker compose --env-file ${PROD_ENV_FILE} ${COMPOSE_FILES} logs --tail=200 || true
            '''
        }
        always {
            sh '''
                echo "=== Cleaning up dangling images ==="
                # buildx/pull 이후 남는 dangling image를 정리해 디스크 사용량을 줄인다.
                docker image prune -f || true
            '''
        }
    }
}

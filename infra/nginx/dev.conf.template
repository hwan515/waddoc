events {
    worker_connections 1024;
}

http {
    server {
        listen 80;

        # Phone frontend
        location = /phone {
            proxy_pass http://frontend-phone:3001;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location = /phone/ {
            return 301 /phone;
        }

        location /phone/ {
            rewrite ^/phone/(.*)$ /$1 break;
            proxy_pass http://frontend-phone:3001;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Spring Swagger UI / OpenAPI
        location = /swagger/spring {
            return 301 /swagger/spring/;
        }

        location = /swagger/spring/ {
            proxy_pass http://spring-api:8080/swagger/swagger-ui/index.html;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location = /swagger/spring/openapi.json {
            proxy_pass http://spring-api:8080/swagger/spring/openapi.json;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /swagger/spring/ {
            rewrite ^/swagger/spring/(.*)$ /swagger/swagger-ui/$1 break;
            proxy_pass http://spring-api:8080;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # FastAPI Swagger UI / OpenAPI
        location = /swagger/fastapi {
            proxy_pass ${DEV_ROBOT_API_PROXY_TARGET};
            proxy_ssl_server_name on;
            proxy_ssl_name $proxy_host;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_redirect off;
        }

        location = /swagger/fastapi/ {
            return 301 /swagger/fastapi;
        }

        location /swagger/fastapi/ {
            proxy_pass ${DEV_ROBOT_API_PROXY_TARGET};
            proxy_ssl_server_name on;
            proxy_ssl_name $proxy_host;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_redirect off;
        }

        # Legacy Swagger paths → new public routes
        location = /swagger-ui.html {
            return 301 /swagger/spring;
        }

        location = /swagger-ui {
            return 301 /swagger/spring;
        }

        location /swagger-ui/ {
            return 301 /swagger/spring;
        }

        location = /v3/api-docs {
            return 301 /swagger/spring/openapi.json;
        }

        location /v3/api-docs/ {
            return 301 /swagger/spring/openapi.json;
        }

        location = /v3/api-docs.yaml {
            return 301 /swagger/spring/openapi.json;
        }

        location = /docs {
            return 301 /swagger/fastapi;
        }

        location = /docs/ {
            return 301 /swagger/fastapi;
        }

        location = /openapi.json {
            return 301 /swagger/fastapi/openapi.json;
        }

        location = /redoc {
            return 301 /swagger/fastapi;
        }

        # ROS2 minimap/command API → remote EC2 robot API
        location = /api/minimap {
            proxy_pass ${DEV_ROBOT_API_PROXY_TARGET};
            proxy_ssl_server_name on;
            proxy_ssl_name $proxy_host;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_redirect off;
        }

        location = /api/odom {
            proxy_pass ${DEV_ROBOT_API_PROXY_TARGET};
            proxy_ssl_server_name on;
            proxy_ssl_name $proxy_host;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_redirect off;
        }

        location /api/cmd/ {
            proxy_pass ${DEV_ROBOT_API_PROXY_TARGET};
            proxy_ssl_server_name on;
            proxy_ssl_name $proxy_host;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_redirect off;
        }

        # API → Spring Boot
        location /api/ {
            proxy_pass http://spring-api:8080;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Frontend → React
        location / {
            proxy_pass http://frontend:3000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }
    }
}

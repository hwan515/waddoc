events {
    worker_connections 1024;
}

http {
    resolver 127.0.0.11 valid=10s;

    server {
        listen 80;

        # 휴대폰 프론트엔드
        location = /phone {
            set $phone_app frontend-phone:3001;
            proxy_pass http://$phone_app;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location = /phone/ {
            return 301 /phone;
        }

        location /phone/ {
            set $phone_app frontend-phone:3001;
            rewrite ^/phone/(.*)$ /$1 break;
            proxy_pass http://$phone_app;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Spring용 Swagger UI와 OpenAPI
        location = /swagger/spring {
            set $core_app core-app:8080;
            proxy_pass http://$core_app;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location = /swagger/spring/ {
            return 301 /swagger/spring;
        }

        location = /swagger/spring/openapi.json {
            set $core_app core-app:8080;
            proxy_pass http://$core_app/swagger/spring/openapi.json;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /swagger/spring/ {
            set $core_app core-app:8080;
            proxy_pass http://$core_app;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Springdoc이 /swagger/spring 을 /swagger/swagger-ui/index.html 로 리다이렉트할 수 있다.
        # 나머지 /swagger/* 경로도 모두 Spring 앱으로 보내서 React가 가로채지 않게 한다.
        location /swagger/ {
            set $core_app core-app:8080;
            proxy_pass http://$core_app;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # 기존 Swagger 경로를 새 공개 경로로 리다이렉트
        location = /swagger-ui.html {
            return 301 /swagger/spring;
        }

        location = /swagger-ui {
            return 301 /swagger/spring;
        }

        location /swagger-ui/ {
            return 301 /swagger/spring;
        }

        location = /v3/api-docs {
            return 301 /swagger/spring/openapi.json;
        }

        location /v3/api-docs/ {
            return 301 /swagger/spring/openapi.json;
        }

        location = /v3/api-docs.yaml {
            return 301 /swagger/spring/openapi.json;
        }

        # Robot telemetry SSE는 edge-bff를 거쳐 owner 서비스로 전달한다.
        location = /api/v1/robots/stream {
            set $edge_bff edge-bff:8080;
            proxy_pass http://$edge_bff;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_buffering off;
            proxy_cache off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            add_header X-Accel-Buffering no always;
        }

        # Doctor notification SSE도 edge-bff가 라우팅 owner를 결정한다.
        location = /api/v1/doctors/me/notifications/stream {
            set $edge_bff edge-bff:8080;
            proxy_pass http://$edge_bff;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_buffering off;
            proxy_cache off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            add_header X-Accel-Buffering no always;
        }

        # 공개 API 진입점은 edge-bff 하나로 고정한다.
        location /api/ {
            set $edge_bff edge-bff:8080;
            proxy_pass http://$edge_bff;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # 프론트엔드 → React
        location / {
            set $frontend_app frontend:3000;
            proxy_pass http://$frontend_app;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;
        }
    }
}
